
# SERVER
NODE_ENV=development
PORT=4000

# EMAIL - RESEND
EMAIL_PROVIDER=unconfigured

RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Alap

# MONGODB
MONGODB_URI=
MONGODB_MAX_POOL_SIZE=20
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# REDIS
REDIS_URL=
REDIS_CONNECT_TIMEOUT_MS=5000

# JWT
ACCESS_TOKEN_ISSUER=production-chat-api-local
ACCESS_TOKEN_AUDIENCE=production-chat-mobile-local

ACCESS_TOKEN_PRIVATE_KEY_BASE64=
ACCESS_TOKEN_PUBLIC_KEY_BASE64=

ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=30

# TEMPORARY AUTH CONFIGURATION: restore only after email delivery is configured
REGISTRATION_OTP_ENABLED=false
PASSWORD_RESET_ENABLED=false

# OTP / PASSWORD RESET
PASSWORD_RESET_TTL_MINUTES=15

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000,http://127.0.0.1:4000

# SERVER CONFIG
BODY_LIMIT=100kb
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000
TRUST_PROXY=false

# LOCAL DOCKER
COMPOSE_PROJECT_NAME=production-chat-local

MONGO_ROOT_USERNAME=chat_local_admin
MONGO_ROOT_PASSWORD=

MONGO_APP_DATABASE=chat_app
MONGO_APP_USERNAME=chat_app
MONGO_APP_PASSWORD=

REDIS_PASSWORD=
