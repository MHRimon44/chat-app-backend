# Activate exactly one section: uncomment its values and comment all values in the other.
# Restart the backend after switching. Replace production placeholders before use.

# Dev
NODE_ENV=development
EMAIL_PROVIDER=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM_EMAIL=security@chat.local
PORT=4000
MONGODB_URI=mongodb://chat_app:replace_with_local_app_password@localhost:27017/chat_app?authSource=chat_app&replicaSet=rs0&directConnection=true
MONGODB_MAX_POOL_SIZE=20
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
REDIS_URL=redis://:replace_with_local_redis_password@localhost:6379/0
REDIS_CONNECT_TIMEOUT_MS=5000
ACCESS_TOKEN_ISSUER=production-chat-api
ACCESS_TOKEN_AUDIENCE=production-chat-mobile
ACCESS_TOKEN_PRIVATE_KEY_BASE64=replace_with_base64_encoded_private_key
ACCESS_TOKEN_PUBLIC_KEY_BASE64=replace_with_base64_encoded_public_key
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=15
PASSWORD_RESET_URL=http://localhost:3000/password/reset
CORS_ALLOWED_ORIGINS=http://localhost:3000
BODY_LIMIT=100kb
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000
TRUST_PROXY=false

# Local Docker services (part of Dev)
COMPOSE_PROJECT_NAME=production-chat-local
MONGO_ROOT_USERNAME=chat_local_admin
MONGO_ROOT_PASSWORD=replace_with_long_random_local_admin_password
MONGO_APP_DATABASE=chat_app
MONGO_APP_USERNAME=chat_app
MONGO_APP_PASSWORD=replace_with_long_random_local_app_password
REDIS_PASSWORD=replace_with_long_random_local_redis_password

# Prod
# NODE_ENV=production
# EMAIL_PROVIDER=ses
# PORT=4000
# MONGODB_URI=mongodb+srv://replace_with_prod_user:replace_with_prod_password@replace_with_prod_cluster/chat_app
