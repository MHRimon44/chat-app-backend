{
  "name": "chat-app-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json --pretty false",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "node --enable-source-maps dist/server.js",
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "jest --runInBand",
    "test:ci": "jest --ci --runInBand",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "security:secrets": "bash scripts/scan-secrets.sh",
    "db:indexes:create": "tsx --env-file=.env src/scripts/create-auth-indexes.ts",
    "verify:local-e2e": "tsx src/scripts/verify-local-e2e.ts",
    "local:setup": "bash scripts/setup-local.sh",
    "local:verify": "yarn infra:verify && yarn db:indexes:create && yarn verify:local-e2e",
    "infra:config": "bash infrastructure/docker/scripts/compose.sh config --no-interpolate",
    "infra:up": "bash infrastructure/docker/scripts/up.sh",
    "infra:down": "bash infrastructure/docker/scripts/compose.sh down",
    "infra:status": "bash infrastructure/docker/scripts/compose.sh ps",
    "infra:logs": "bash infrastructure/docker/scripts/compose.sh logs -f mongo redis mailpit",
    "infra:verify": "bash infrastructure/docker/scripts/verify.sh",
    "infra:reset": "bash infrastructure/docker/scripts/reset.sh"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1118.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.45.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "mongoose": "^9.9.4",
    "nodemailer": "^9.0.5",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "redis": "^6.2.1",
    "socket.io": "^4.8.1",
    "socket.io-adapter": "^2.5.8",
    "swagger-ui-express": "5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.68.0"
  }
}
